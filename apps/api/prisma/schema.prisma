generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int              @id @default(autoincrement())
  email              String           @unique
  password           String
  hashedRefreshToken String?
  role               Role             @default(USER)
  firstName          String?
  lastName           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  isClient           Boolean          @default(false)
  phone              String?
  promptVersions     PromptVersion[]
  featureRequests    FeatureRequest[]
  confirmations      Confirmation[]
}

model File {
  id                  Int            @id @default(autoincrement())
  mimeType            String
  size                Int
  publicUrl           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  key                 String
  provider            FileProvider   @default(LOCAL)
  inputConfirmations  Confirmation[] @relation("InputFileConfirmation")
  outputConfirmations Confirmation[] @relation("OutputFileConfirmation")
}

model Confirmation {
  id           Int      @id @default(autoincrement())
  inputFileId  Int
  outputFileId Int?
  shipper      String
  importer     String
  createdById  Int? // TODO: backfill existing rows, then make NOT NULL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inputFile    File     @relation("InputFileConfirmation", fields: [inputFileId], references: [id])
  outputFile   File?    @relation("OutputFileConfirmation", fields: [outputFileId], references: [id])
  createdBy    User?    @relation(fields: [createdById], references: [id])
}

enum Role {
  ADMIN
  USER
}

model PromptVersion {
  id          Int      @id @default(autoincrement())
  version     Int      @unique
  model       String
  prompt      String
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model FeatureRequest {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSetting {
  id                     Int      @id @default(autoincrement())
  useNewConfirmationForm Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

enum FileProvider {
  LOCAL
  R2
}
